# Supabase Configuration
# Get these values from your Supabase project settings
# Go to Settings > API to find both values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Note: Never commit .env.local or .env.production.local
# Only the VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY are used in the browser
# The publishable key is browser-safe but database access is still controlled by RLS policies
# Service-role keys and database passwords should never be included in frontend code
